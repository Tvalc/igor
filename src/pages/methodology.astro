---
import Base from '../layouts/Base.astro';
import { FACTOR_LABELS, GROUP_LABELS, WEIGHTS, type Factor, type Group } from '../lib/score';

const groups = Object.keys(WEIGHTS) as Group[];
const factors = Object.keys(FACTOR_LABELS) as Factor[];
---

<Base
  title="How We Rank AI Game Dev Tools"
  description="The public scoring method behind every Make AI Games ranking: factors, weights per category, how unknown facts are handled, and how hands-on tests are added."
  crumbs={[{ name: 'How we rank', href: '/methodology' }]}
>
  <article class="prose">
    <h1>How we rank</h1>
    <div class="answer">
      <p>
        Every tool gets a <strong>score from 0 to 100</strong>, computed by code from verified facts with
        the published weights below. Hands-on test results are blended in at 50% once a test is published. Affiliate
        links, sponsorships and ownership never change a score.
      </p>
    </div>

    <h2>The factors</h2>
    <ul>
      {factors.map((k) => (<li><strong>{FACTOR_LABELS[k].label}:</strong> {FACTOR_LABELS[k].question}</li>))}
    </ul>
  </article>

  <h2 class="mt-12 mb-3 text-2xl font-semibold">Weights by category</h2>
  <p class="text-muted-foreground mb-5 max-w-3xl">Different jobs need different things. Commercial rights matter most for audio, and integrations matter most for coding tools.</p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Factor</th>{groups.map((g) => <th>{GROUP_LABELS[g]}</th>)}</tr>
      </thead>
      <tbody>
        {
          factors.map((k) => (
            <tr>
              <td>{FACTOR_LABELS[k].label}</td>
              {groups.map((g) => <td class="num">{Math.round(WEIGHTS[g][k] * 100)}%</td>)}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <article class="prose mt-4">
    <h2>Rules we follow</h2>
    <ul>
      <li>
        <strong>Facts come from primary sources.</strong> Each tool page lists its sources and a last-verified date.
        Anything we haven't confirmed shows as "Not listed", "Not confirmed" or "See site for pricing", never as a yes or a no.
      </li>
      <li>
        <strong>Unknown never helps a tool.</strong> An unverified fact scores below the midpoint, so verifying a tool
        can only move it in the direction the facts point. The four key facts are free tier, price, commercial use and exports; a tool missing
        some of them scores lower until they're confirmed. Vendors can send a primary source to fill a gap.
      </li>
      <li>
        <strong>Features are checked, not assumed.</strong> Every tool has a feature checklist for its category (for
        example pixel art, sprite sheets and 8-direction views for sprite tools). A feature is marked Yes, Partly or No
        only when the vendor's own site, docs or pricing page says so; everything else shows as "Not confirmed". Features
        power the comparison tables and don't change scores.
      </li>
      <li>
        <strong>Scores are computed, not chosen.</strong> The scoring code is open in our repository, and nobody
        adjusts a number by hand.
      </li>
      <li>
        <strong>Hands-on tests are real.</strong> A hands-on score exists only after we publish the test, with the
        prompt and outputs. Until then, pages say the score is facts-based.
      </li>
      <li>
        <strong>Discontinued tools stay listed, but unranked</strong>, so people searching for them find the
        replacement.
      </li>
      <li>
        <strong>Freshness is automated.</strong> Agents re-check pricing, status and changelogs every week and propose
        changes with sources. Schema checks reject malformed data before it ships.
      </li>
    </ul>

    <h2>Ownership and money</h2>
    <p>
      This site is run by the Makko AI team, and Makko is scored by exactly the same rules. Some links are affiliate
      links, and sponsored placements are labeled. See the <a href="/disclosure">full disclosure</a>.
    </p>
  </article>
</Base>

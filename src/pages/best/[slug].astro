---
import Base from '../../layouts/Base.astro';
import { RankTable } from '../../components/site/RankTable';
import { Faq } from '../../components/site/Faq';
import { PicksBox } from '../../components/site/PicksBox';
import { FeatureMatrix } from '../../components/site/FeatureMatrix';
import { LIST_ICON } from '../../components/site/icons';
import Listing from '../../components/site/Listing.astro';
import { buttonVariants } from '../../components/ui/button';
import { computePicks } from '../../lib/picks';
import { ArrowRight, BadgeCheck, CalendarDays, ListOrdered, Trophy } from 'lucide-react';
import { FEATURES } from '../../lib/features';
import { publishedLists, toolsWithAlternatives, type ListDef } from '../../lib/lists';
import { FACTOR_LABELS, strengths, type Scored } from '../../lib/score';
import { itemList, faqPage } from '../../lib/jsonld';
import { SITE } from '../../site';

export async function getStaticPaths() {
  return (await publishedLists()).map(({ def, ranked }) => ({ params: { slug: def.slug }, props: { def, ranked } }));
}

interface Props {
  def: ListDef;
  ranked: Scored[];
}
const { def, ranked } = Astro.props;
const base = Astro.site!.toString().replace(/\/$/, '');
const [first, second, third] = ranked;
const why = strengths(first).map((f) => FACTOR_LABELS[f].label.toLowerCase());
const freeOnes = ranked.filter((s) => s.tool.data.pricing.free_tier === 'yes');
const commercialOnes = ranked.filter((s) => s.tool.data.license.commercial_use === 'yes');
const beginnerOnes = ranked.filter((s) => s.tool.data.skill_level === 'beginner');
const hasMakko = ranked.some((s) => s.tool.data.makko_owned);
const withAlts = await toolsWithAlternatives();
const matrixTools = ranked.slice(0, 6).map((s) => s.tool);
const matrixDefs = def.features ? FEATURES[def.features] : [];
const pickLabel = new Map(computePicks(ranked).map((p) => [p.s.tool.id, p.label]));
const names = (xs: Scored[], n = 3) => xs.slice(0, n).map((s) => s.tool.data.name).join(', ');

const faqs = [
  {
    q: def.question,
    a: `On our facts-based score, ${first.tool.data.name} ranks first (${first.score}/100), followed by ${second.tool.data.name}${third ? ` and ${third.tool.data.name}` : ''}. ${first.tool.data.name} is best for: ${first.tool.data.best_for}`,
  },
  freeOnes.length > 0 && {
    q: `Which of these tools are free?`,
    a: `${freeOnes.length} of the ${ranked.length} tools on this list have a free tier, including ${names(freeOnes)}. Free tiers often limit exports or commercial use, so check the license row on each tool page.`,
  },
  {
    q: `Can I sell games made with these tools?`,
    a:
      commercialOnes.length > 0
        ? `We've verified that ${names(commercialOnes)} allow commercial use outright. Others allow it only on paid plans or don't say. Each tool page shows the details.`
        : `None of these tools clearly allows commercial use on every plan. Several allow it on paid plans, so check each tool page before shipping.`,
  },
  beginnerOnes.length > 0 && {
    q: `Which tools work for complete beginners?`,
    a: `${names(beginnerOnes)} need no coding or technical setup.`,
  },
  {
    q: 'How are these tools ranked?',
    a: `Every tool is scored the same way, on accessibility, output and integrations, commercial rights, value and maturity. Hands-on test results are added as tests are published. Affiliate links and sponsorships never change a score.`,
  },
].filter(Boolean) as { q: string; a: string }[];

const title = `${def.title} (${SITE.year})`;
const description = `${def.title}, ranked: ${names(ranked)} and more, compared on free tiers, pricing, commercial rights and exports. Updated ${SITE.year}.`;
const ListIcon = LIST_ICON[def.slug] ?? Trophy;
---

<Base
  title={title}
  description={description}
  crumbs={[{ name: 'Best lists', href: '/best/' }, { name: def.title, href: `/best/${def.slug}` }]}
  markdownPath={`/best/${def.slug}.md`}
  jsonLd={[
    itemList(def.title, ranked.map((s) => ({ name: s.tool.data.name, url: `${base}/tools/${s.tool.id}` }))),
    faqPage(faqs),
  ]}
>
  <header class="mt-6 max-w-3xl">
    <span class="eyebrow"><ListIcon className="size-3.5" /> Ranking</span>
    <h1 class="mt-3 text-3xl font-bold sm:text-5xl">{title}</h1>
    <div class="text-muted-foreground mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
      <span class="inline-flex items-center gap-1.5"><CalendarDays className="size-4" /> Updated {SITE.year}</span>
      <span class="inline-flex items-center gap-1.5"><ListOrdered className="size-4" /> {ranked.length} tools compared</span>
      <a href="/methodology" class="hover:text-foreground inline-flex items-center gap-1.5 underline"><BadgeCheck className="size-4" /> How we rank</a>
    </div>
  </header>
  <div class="answer max-w-3xl">
    <p>
      The best options are <strong>{first.tool.data.name}</strong>, <strong>{second.tool.data.name}</strong>
      {third && <>and <strong>{third.tool.data.name}</strong></>}.
      {first.tool.data.name} ranks first with a score of {first.score}/100{why.length > 0 && <>, led by {why.join(' and ')}</>}.
      {def.blurb}
    </p>
  </div>
  {
    hasMakko && (
      <p class="notice max-w-3xl">
        Disclosure: this site is run by {SITE.owner}. Makko appears on this list, scored the same way as everything else.
      </p>
    )
  }

  <h2 class="mt-12 mb-5 text-2xl font-semibold">Our picks</h2>
  <PicksBox ranked={ranked} />

  <h2 class="mt-14 mb-5 text-2xl font-semibold">All {ranked.length} ranked</h2>
  <Listing items={ranked} ranked picks={pickLabel} categories={false} search={false} />

  <h2 class="mt-14 mb-5 text-2xl font-semibold">Comparison table</h2>
  <RankTable ranked={ranked} />

  {
    matrixDefs.length > 0 && matrixTools.some((t) => Object.keys(t.data.features).length > 0) && (
      <>
        <div class="mt-14 mb-5 flex flex-wrap items-end justify-between gap-3">
          <h2 class="text-2xl font-semibold">Feature comparison: top {matrixTools.length}</h2>
          <a class={buttonVariants({ variant: 'outline', size: 'sm' })} href={`/compare/?tools=${matrixTools.slice(0, 4).map((t) => t.id).join(',')}`}>
            Compare the top 4 side by side <ArrowRight />
          </a>
        </div>
        <FeatureMatrix tools={matrixTools} defs={matrixDefs} />
      </>
    )
  }

  {
    withAlts.size > 0 && (
      <div class="mt-8 flex flex-wrap items-center gap-2 text-sm">
        <span class="text-muted-foreground">Looking for alternatives?</span>
        {ranked.slice(0, 5).filter((s) => withAlts.has(s.tool.id)).map((s) => (
          <a href={`/alternatives/${s.tool.id}`} class={buttonVariants({ variant: 'secondary', size: 'sm' })}>{s.tool.data.name} alternatives</a>
        ))}
      </div>
    )
  }

  <Faq faqs={faqs} />
</Base>

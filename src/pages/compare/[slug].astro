---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import ToolLogo from '../../components/ToolLogo.astro';
import Stars from '../../components/Stars.astro';
import FeatureMatrix from '../../components/FeatureMatrix.astro';
import Plans from '../../components/Plans.astro';
import { COMMERCIAL_RANK, FREE_RANK, fromPrice, priceLabel, sharedFeatures } from '../../lib/compare';
import { comparisonPairs, toolsWithAlternatives, type ListDef } from '../../lib/lists';
import { scoreTool, FACTOR_LABELS, type Factor, type Group, type Tool } from '../../lib/score';
import { faqPage } from '../../lib/jsonld';
import {
  COMMERCIAL_LABELS, ENGINE_LABELS, EXPORT_LABELS, FREE_TIER_LABELS, STATUS_LABELS, isoDate, list, tier,
} from '../../lib/format';
import { SITE } from '../../site';
import { outboundRel, outboundUrl, shown } from '../../lib/format';

export async function getStaticPaths() {
  return [...(await comparisonPairs()).entries()].map(([slug, p]) => ({ params: { slug }, props: p }));
}

interface Props {
  a: Tool;
  b: Tool;
  group: Group;
  list: ListDef;
}
const { a, b, group, list: listDef } = Astro.props;
const sa = scoreTool(a, group);
const sb = scoreTool(b, group);
const winner = sa.score === sb.score ? null : sa.score > sb.score ? sa : sb;
const factorKeys = Object.keys(sa.factors) as Factor[];
const edge = (k: Factor) =>
  Math.abs(sa.factors[k] - sb.factors[k]) < 0.05 ? 'Even' : sa.factors[k] > sb.factors[k] ? a.data.name : b.data.name;
const wins = (s: typeof sa, o: typeof sb) =>
  factorKeys.filter((k) => s.factors[k] - o.factors[k] >= 0.05).map((k) => FACTOR_LABELS[k].label.toLowerCase());
const aWins = wins(sa, sb);
const bWins = wins(sb, sa);
const hasMakko = a.data.makko_owned || b.data.makko_owned;
const withAlts = await toolsWithAlternatives();

// Each row can name a "better" side so the table can mark it; ties and unknowns mark nothing.
type Row = [string, (t: Tool) => string, ((t: Tool) => number | null)?, ('max' | 'min')?];
const rows: Row[] = [
  ['Best for', (t) => t.data.best_for],
  ['Free tier', (t) => FREE_TIER_LABELS[t.data.pricing.free_tier], (t) => FREE_RANK[t.data.pricing.free_tier] || null],
  ['Starting price', (t) => priceLabel(t), (t) => fromPrice(t), 'min'],
  ['Commercial use', (t) => (t.data.license.open_source ? `${shown(COMMERCIAL_LABELS[t.data.license.commercial_use])} (open source)` : COMMERCIAL_LABELS[t.data.license.commercial_use]), (t) => COMMERCIAL_RANK[t.data.license.commercial_use] || null],
  ['Engines', (t) => list(t.data.engines, ENGINE_LABELS)],
  ['Exports', (t) => list(t.data.exports, EXPORT_LABELS)],
  ['Skill level', (t) => t.data.skill_level],
  ['Status', (t) => STATUS_LABELS[t.data.status]],
  ['Last verified', (t) => isoDate(t.data.last_verified)],
];

const better = (row: Row) => {
  const [, , val, mode = 'max'] = row;
  if (!val) return null;
  const x = val(a), y = val(b);
  if (x === null || y === null || x === y) return null;
  return (mode === 'max' ? x > y : x < y) ? a.id : b.id;
};

const featureDefs = sharedFeatures([a, b]);
const engineNames = (t: Tool) => t.data.engines.map((e) => ENGINE_LABELS[e]);
/** Reasons to pick `t` over `o`, from facts only. A gap in the other tool's data is never counted as a reason. */
function chooseIf(t: Tool, o: Tool): string[] {
  const out: string[] = [];
  const td = t.data, od = o.data;
  if (FREE_RANK[td.pricing.free_tier] > FREE_RANK[od.pricing.free_tier] && od.pricing.free_tier !== 'unknown' && ['yes', 'limited'].includes(td.pricing.free_tier))
    out.push('you want to start for free');
  const tp = fromPrice(t), op = fromPrice(o);
  if (tp !== null && op !== null && tp < op) out.push(`you want a lower starting price (${priceLabel(t)} vs ${priceLabel(o)})`);
  if (COMMERCIAL_RANK[td.license.commercial_use] > COMMERCIAL_RANK[od.license.commercial_use] && od.license.commercial_use !== 'unknown')
    out.push(`you plan to sell what you make (commercial use: ${COMMERCIAL_LABELS[td.license.commercial_use].toLowerCase()})`);
  if (td.skill_level === 'beginner' && od.skill_level !== 'beginner') out.push("you're a beginner or don't code");
  const extraEngines = engineNames(t).filter((e) => !engineNames(o).includes(e));
  if (extraEngines.length && od.engines.length) out.push(`you work in ${extraEngines.join(' or ')}`);
  for (const f of featureDefs) {
    const v = td.features[f.key], w = od.features[f.key];
    if (v === 'yes' && (w === 'no' || w === 'partial')) out.push(`you need ${f.label.toLowerCase()}`);
  }
  if (td.license.open_source && !od.license.open_source) out.push('you want open source you can self-host');
  return out.slice(0, 5);
}
const chooseA = chooseIf(a, b);
const chooseB = chooseIf(b, a);
const plansShown = a.data.plans.length > 0 || b.data.plans.length > 0;

const faqs = [
  {
    q: `Is ${a.data.name} or ${b.data.name} better?`,
    a: winner
      ? `${winner.tool.data.name} scores higher in our ${listDef.title.replace(/^Best /, '')} ranking (${sa.score} vs ${sb.score}). The right pick depends on the job. ${a.data.name} is best for: ${a.data.best_for} ${b.data.name} is best for: ${b.data.best_for}`
      : `They tie at ${sa.score}/100 in our scoring. ${a.data.name} is best for: ${a.data.best_for} ${b.data.name} is best for: ${b.data.best_for}`,
  },
  {
    q: `Which is cheaper, ${a.data.name} or ${b.data.name}?`,
    a: `${a.data.name}: ${FREE_TIER_LABELS[a.data.pricing.free_tier].toLowerCase()}, ${priceLabel(a).toLowerCase()}. ${b.data.name}: ${FREE_TIER_LABELS[b.data.pricing.free_tier].toLowerCase()}, ${priceLabel(b).toLowerCase()}.`,
  },
];
---

<Base
  title={`${a.data.name} vs ${b.data.name} (${SITE.year}): Which Is Better?`}
  description={`${a.data.name} vs ${b.data.name} compared on free tiers, pricing, commercial rights, engines and exports. Scores: ${sa.score} vs ${sb.score}.`}
  crumbs={[{ name: 'Compare', href: '/compare/' }, { name: `${a.data.name} vs ${b.data.name}`, href: `/compare/${a.id}-vs-${b.id}` }]}
  jsonLd={[faqPage(faqs)]}
>
  <h1>{a.data.name} vs {b.data.name}</h1>
  <div class="vs-head">
    {[sa, sb].map((s, i) => (
      <>
        {i === 1 && <span class="vs-badge" aria-hidden="true">VS</span>}
        <div class={`card vs-card${winner?.tool.id === s.tool.id ? ' vs-win' : ''}`}>
          <ToolLogo name={s.tool.data.name} url={s.tool.data.url} size="lg" />
          <a class="vs-name" href={`/tools/${s.tool.id}`}>{s.tool.data.name}</a>
          <Stars score={s.score} />
          {winner?.tool.id === s.tool.id ? <span class="badge badge-pick">Higher score</span> : <span class="badge badge-muted">{shown(priceLabel(s.tool), 'price')}</span>}
          {s.tool.data.status !== 'discontinued' && (
            <a class="btn btn-sm" href={outboundUrl(s.tool)} rel={outboundRel(s.tool)} target="_blank">Visit site</a>
          )}
        </div>
      </>
    ))}
  </div>
  <div class="answer">
    <p>
      {
        winner ? (
          <>
            <strong>{winner.tool.data.name}</strong> comes out ahead, {Math.max(sa.score, sb.score)} to{' '}
            {Math.min(sa.score, sb.score)}, on our{' '}
            {listDef.title.replace(/^Best /, '')} ranking.
          </>
        ) : (
          <>They tie at {sa.score}/100 in our scoring.</>
        )
      }
      {aWins.length > 0 && <> {a.data.name} leads on {aWins.join(', ')}.</>}
      {bWins.length > 0 && <> {b.data.name} leads on {bWins.join(', ')}.</>}
      {a.data.name} is best for: {a.data.best_for} {b.data.name} is best for: {b.data.best_for}
    </p>
  </div>
  {
    hasMakko && (
      <p class="notice">
        Disclosure: this site is run by {SITE.owner}. Both tools are scored the same way.
      </p>
    )
  }

  <h2>Side by side</h2>
  <label class="diff-toggle"><input type="checkbox" data-diff-toggle /> Only show differences</label>
  <div class="table-wrap" data-diff-table>
    <table>
      <thead>
        <tr>
          <th>Fact</th>
          <th><span class="th-tool"><ToolLogo name={a.data.name} url={a.data.url} size="sm" /><a href={`/tools/${a.id}`}>{a.data.name}</a></span></th>
          <th><span class="th-tool"><ToolLogo name={b.data.name} url={b.data.url} size="sm" /><a href={`/tools/${b.id}`}>{b.data.name}</a></span></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Score</strong></td>
          <td class="num"><span class={`score tier-${tier(sa.score)}`}>{sa.score}</span></td>
          <td class="num"><span class={`score tier-${tier(sb.score)}`}>{sb.score}</span></td>
        </tr>
        {
          rows.map((row) => {
            const [label, fn] = row;
            const win = better(row);
            return (
              <tr class:list={[{ same: fn(a) === fn(b) }]}>
                <td><strong>{label}</strong></td>
                <td class:list={[{ best: win === a.id }, { unverified: fn(a) === 'Unverified' }]}>{shown(fn(a), label === 'Starting price' ? 'price' : 'fact')}</td>
                <td class:list={[{ best: win === b.id }, { unverified: fn(b) === 'Unverified' }]}>{shown(fn(b), label === 'Starting price' ? 'price' : 'fact')}</td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>

  <p class="meta">★ marks the better option in each row.</p>

  {
    (chooseA.length > 0 || chooseB.length > 0) && (
      <>
        <h2>Which should you choose?</h2>
        <div class="choose">
          {[[a, chooseA], [b, chooseB]].map(([t, reasons]) => (
            <div class="card">
              <h3><ToolLogo name={(t as Tool).data.name} url={(t as Tool).data.url} size="sm" /> Choose {(t as Tool).data.name} if…</h3>
              {(reasons as string[]).length ? (
                <ul>{(reasons as string[]).map((r) => <li>{r}</li>)}</ul>
              ) : (
                <p>{(t as Tool).data.best_for}</p>
              )}
            </div>
          ))}
        </div>
      </>
    )
  }

  {
    featureDefs.length > 0 && (
      <>
        <h2>Features compared</h2>
        <FeatureMatrix tools={[a, b]} defs={featureDefs} />
      </>
    )
  }

  {
    plansShown && (
      <>
        <h2>Pricing plans</h2>
        {[a, b].map((t) => (
          <>
            <h3>{t.data.name}</h3>
            {t.data.plans.length ? <Plans tool={t} /> : <p class="unverified">{t.data.pricing.notes ?? 'See the vendor site for current plans.'}</p>}
          </>
        ))}
      </>
    )
  }

  <p>
    <a class="btn btn-ghost" href={`/compare/?tools=${a.id},${b.id}`}>Add a third tool to this comparison</a>
  </p>

  <h2>Factor by factor</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Factor</th><th>{a.data.name}</th><th>{b.data.name}</th><th>Edge</th></tr></thead>
      <tbody>
        {
          factorKeys.map((k) => (
            <tr>
              <td>{FACTOR_LABELS[k].label}</td>
              <td class="num">{Math.round(sa.factors[k] * 100)}</td>
              <td class="num">{Math.round(sb.factors[k] * 100)}</td>
              <td>{edge(k)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>What each one is</h2>
  <h3><a href={`/tools/${a.id}`}>{a.data.name}</a></h3>
  <p>{a.data.description}</p>
  <h3><a href={`/tools/${b.id}`}>{b.data.name}</a></h3>
  <p>{b.data.description}</p>

  <p>
    See the full ranking: <a href={`/best/${listDef.slug}`}>{listDef.title}</a>.
    {[a, b].filter((t) => withAlts.has(t.id)).map((t) => (
      <> · <a href={`/alternatives/${t.id}`}>{t.data.name} alternatives</a></>
    ))}
  </p>

  <Faq faqs={faqs} />

  <script>
    document.querySelectorAll<HTMLInputElement>('[data-diff-toggle]').forEach((box) =>
      box.addEventListener('change', () => document.querySelector('[data-diff-table]')?.classList.toggle('only-diff', box.checked)),
    );
  </script>
</Base>

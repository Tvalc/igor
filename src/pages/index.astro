---
import Base from '../layouts/Base.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import ToolCard from '../components/ToolCard.astro';
import ToolLogo from '../components/ToolLogo.astro';
import SearchBox from '../components/SearchBox.astro';
import { CATEGORY_LABELS } from '../lib/format';
import { CATEGORIES } from '../content.config';
import { activeTools, comparisonPairs, publishedLists, LIST_ICONS } from '../lib/lists';
import { SITE } from '../site';

const tools = await activeTools();
const live = tools.filter((t) => t.data.status !== 'discontinued').length;
const lists = await publishedLists();
const pairs = (await comparisonPairs()).size;
const byslug = Object.fromEntries(lists.map((l) => [l.def.slug, l]));

const picks = [
  { label: 'Game maker', slug: 'ai-game-makers' },
  { label: 'Sprites & pixel art', slug: 'ai-sprite-generators' },
  { label: '3D models', slug: 'ai-3d-model-generators' },
  { label: 'Coding & engines', slug: 'ai-coding-tools-for-game-dev' },
  { label: 'Music', slug: 'ai-music-generators-for-games' },
  { label: 'NPCs & dialogue', slug: 'ai-npc-tools' },
]
  .map((p) => ({ ...p, top: byslug[p.slug]?.ranked[0] }))
  .filter((p) => p.top);

const routes = [
  {
    step: 'Route 1',
    title: 'No code: prompt to game',
    body: 'Describe the game and a platform builds it, art and hosting included. Fastest way to something playable.',
    points: ['Best for beginners and game jams', 'Runs in the browser', 'Fewer export options'],
    href: '/best/no-code-ai-game-makers',
    cta: 'No-code game makers',
  },
  {
    step: 'Route 2',
    title: 'AI inside a real engine',
    body: 'Unity, Godot and GDevelop now ship AI assistants and MCP plugins. You keep a real project that exports anywhere.',
    points: ['PC, mobile and console exports', 'AI does setup and scripting', 'Some learning curve'],
    href: '/best/ai-for-godot',
    cta: 'AI for game engines',
  },
  {
    step: 'Route 3',
    title: 'A coding agent writes it',
    body: 'Coding agents build the game in any engine or plain JavaScript, and connect to engines through MCP.',
    points: ['Maximum control', 'Works with any engine', 'Comfort with code helps'],
    href: '/best/ai-coding-tools-for-game-dev',
    cta: 'AI coding tools',
  },
];

const CAT_ICONS: Record<string, IconName> = {
  'game-maker': 'gamepad', 'art-2d': 'pixel', 'art-3d': 'cube', texture: 'grid', animation: 'motion',
  code: 'code', voice: 'mic', music: 'music', sfx: 'wave', npc: 'chat',
};
const catTiles = CATEGORIES.map((c) => ({ c, n: tools.filter((t) => t.data.status !== 'discontinued' && (t.data.categories as string[]).includes(c)).length }));
const topPicks = picks.slice(0, 6);
const pairEntries = [...(await comparisonPairs()).entries()];
const popularPairs = ['ai-game-makers', 'ai-sprite-generators', 'ai-3d-model-generators', 'ai-coding-tools-for-game-dev', 'ai-music-generators-for-games', 'ai-voice-generators-for-games']
  .map((slug) => pairEntries.find(([, p]) => p.list.slug === slug))
  .filter((x) => x !== undefined)
  .concat(pairEntries.filter(([, p]) => p.list.slug === 'ai-game-makers').slice(1, 3))
  .slice(0, 8);

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: Astro.site!.toString(),
  description: SITE.description,
};
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: Astro.site!.toString(),
  logo: new URL('/favicon.svg', Astro.site).toString(),
};
---

<Base
  title={`${SITE.name}: Every Tool to Make Games with AI, Ranked (${SITE.year})`}
  description={`Want to make games with AI? We rank and compare ${live} AI game makers, sprite and 3D generators, coding assistants and audio tools on free tiers, pricing and commercial rights.`}
  jsonLd={[website, organization]}
>
  <section class="hero" slot="hero">
    <div class="wrap">
      <span class="eyebrow"><Icon name="gamepad" size={16} /> {live} AI game dev tools compared</span>
      <h1>Find the right AI tool to <em>make your game</em></h1>
      <p class="lede">
        Compare AI game makers, sprite and 3D generators, coding assistants and audio AI side by side: prices, free
        plans, commercial rights and features, checked against each vendor's own site.
      </p>
      <SearchBox variant="hero" placeholder="Search tools, e.g. sprite generator, Unity, Meshy" />
      <div class="chips">
        <a class="chip" href="/best/no-code-ai-game-makers"><Icon name="wand" size={15} /> Make a game, no code</a>
        <a class="chip" href="/best/2d-game-makers"><Icon name="pixel" size={15} /> 2D games</a>
        <a class="chip" href="/best/ai-sprite-generators"><Icon name="image" size={15} /> Sprites &amp; pixel art</a>
        <a class="chip" href="/best/ai-3d-model-generators"><Icon name="cube" size={15} /> 3D models</a>
        <a class="chip" href="/best/free-ai-game-dev-tools"><Icon name="gift" size={15} /> Free tools</a>
        <a class="chip" href="/compare/"><Icon name="layers" size={15} /> Compare tools</a>
      </div>
      <div class="trust">
        <span><Icon name="shield" size={16} /> Facts checked on vendor sites</span>
        <span><Icon name="clock" size={16} /> Re-checked weekly</span>
        <span><Icon name="check" size={16} /> {pairs} head-to-head comparisons</span>
        <span><Icon name="check" size={16} /> <a href="/methodology">Public scoring rubric</a></span>
      </div>
    </div>
  </section>

  <div class="section-head">
    <h2>Browse by category</h2>
    <a href="/tools/">All {live} tools →</a>
  </div>
  <div class="grid">
    {
      catTiles.map(({ c, n }) => (
        <a class="card cat-tile" href={`/tools/?category=${c}`}>
          <span class="card-icon"><Icon name={CAT_ICONS[c]} /></span>
          <span>
            <strong>{CATEGORY_LABELS[c]}</strong>
            <span class="sub">{n} tools</span>
          </span>
        </a>
      ))
    }
  </div>

  <div class="section-head">
    <h2>Top pick in each category</h2>
    <a href="/best/">All {lists.length} rankings →</a>
  </div>
  <ul class="tool-grid">
    {topPicks.map((p) => <ToolCard scored={p.top!} pick={`#1 ${p.label}`} />)}
  </ul>

  <div class="section-head">
    <h2>Popular comparisons</h2>
    <a href="/compare/">Build your own →</a>
  </div>
  <div class="grid">
    {
      popularPairs.map(([slug, p]) => (
        <a class="card pair-card" href={`/compare/${slug}`}>
          <ToolLogo name={p.a.data.name} url={p.a.data.url} size="sm" />
          <span class="vs">VS</span>
          <ToolLogo name={p.b.data.name} url={p.b.data.url} size="sm" />
          <strong>{p.a.data.name} vs {p.b.data.name}</strong>
        </a>
      ))
    }
  </div>

  <div class="section-head">
    <h2>Three ways to make a game with AI</h2>
    <a href="/guides/how-to-make-a-game-with-ai">Step-by-step guide →</a>
  </div>
  <div class="grid-3">
    {
      routes.map((r) => (
        <div class="card route">
          <span class="step">{r.step}</span>
          <h3>{r.title}</h3>
          <p>{r.body}</p>
          <ul>{r.points.map((pt) => <li>{pt}</li>)}</ul>
          <p class="card-foot"><a href={r.href}>{r.cta} →</a></p>
        </div>
      ))
    }
  </div>

  <div class="section-head">
    <h2>Every ranking</h2>
    <a href="/best/">See all →</a>
  </div>
  <div class="grid">
    {
      lists.map(({ def, ranked }) => (
        <a class="card cat-tile" href={`/best/${def.slug}`}>
          <span class="card-icon"><Icon name={(LIST_ICONS[def.slug] ?? 'gamepad') as IconName} /></span>
          <span>
            <strong>{def.title.replace(/^Best /, '')}</strong>
            <span class="sub">{ranked.length} ranked · #1 {ranked[0].tool.data.name}</span>
          </span>
        </a>
      ))
    }
  </div>

  <div class="grid-3" style="margin-top:40px">
    <a class="card" href="/guides/make-2d-games-with-ai">
      <span class="card-icon"><Icon name="pixel" /></span>
      <h3>Make 2D games with AI</h3>
      <p>2D game makers, consistent sprites, tilesets and animation.</p>
    </a>
    <a class="card" href="/guides/make-game-art-with-ai">
      <span class="card-icon"><Icon name="image" /></span>
      <h3>Make game art with AI</h3>
      <p>Concept art, sprites, 3D models, textures, and who owns the rights.</p>
    </a>
    <a class="card" href="/methodology">
      <span class="card-icon"><Icon name="shield" /></span>
      <h3>How we rank</h3>
      <p>Six factors, published weights, no hand-picked scores. Run by the Makko team, disclosed everywhere.</p>
    </a>
  </div>
</Base>

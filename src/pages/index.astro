---
import Base from '../layouts/Base.astro';
import { ToolCard } from '../components/site/ToolCard';
import { ToolLogo } from '../components/site/ToolLogo';
import { SectionHeader } from '../components/site/SectionHeader';
import { CATEGORY_ICONS, LIST_ICON } from '../components/site/icons';
import { Badge } from '../components/ui/badge';
import { buttonVariants } from '../components/ui/button';
import { cn } from '../lib/utils';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../components/ui/card';
import { ArrowRight, BadgeCheck, Clock, Scale, Search, ShieldCheck } from 'lucide-react';
import { CATEGORY_LABELS } from '../lib/format';
import { CATEGORIES } from '../content.config';
import { activeTools, comparisonPairs, publishedLists } from '../lib/lists';
import { SITE } from '../site';

const tools = await activeTools();
const live = tools.filter((t) => t.data.status !== 'discontinued').length;
const lists = await publishedLists();
const pairs = (await comparisonPairs()).size;
const byslug = Object.fromEntries(lists.map((l) => [l.def.slug, l]));

const picks = [
  { label: 'Game maker', slug: 'ai-game-makers' },
  { label: 'Sprites & pixel art', slug: 'ai-sprite-generators' },
  { label: '3D models', slug: 'ai-3d-model-generators' },
  { label: 'Coding & engines', slug: 'ai-coding-tools-for-game-dev' },
  { label: 'Music', slug: 'ai-music-generators-for-games' },
  { label: 'NPCs & dialogue', slug: 'ai-npc-tools' },
]
  .map((p) => ({ ...p, top: byslug[p.slug]?.ranked[0] }))
  .filter((p) => p.top);

const routes = [
  {
    step: 'Route 1',
    title: 'No code: prompt to game',
    body: 'Describe the game and a platform builds it, art and hosting included. Fastest way to something playable.',
    points: ['Best for beginners and game jams', 'Runs in the browser', 'Fewer export options'],
    href: '/best/no-code-ai-game-makers',
    cta: 'No-code game makers',
  },
  {
    step: 'Route 2',
    title: 'AI inside a real engine',
    body: 'Unity, Godot and GDevelop now ship AI assistants and MCP plugins. You keep a real project that exports anywhere.',
    points: ['PC, mobile and console exports', 'AI does setup and scripting', 'Some learning curve'],
    href: '/best/ai-for-godot',
    cta: 'AI for game engines',
  },
  {
    step: 'Route 3',
    title: 'A coding agent writes it',
    body: 'Coding agents build the game in any engine or plain JavaScript, and connect to engines through MCP.',
    points: ['Maximum control', 'Works with any engine', 'Comfort with code helps'],
    href: '/best/ai-coding-tools-for-game-dev',
    cta: 'AI coding tools',
  },
];

const catTiles = CATEGORIES.map((c) => ({ c, n: tools.filter((t) => t.data.status !== 'discontinued' && (t.data.categories as string[]).includes(c)).length }));
const topPicks = picks.slice(0, 6);
const pairEntries = [...(await comparisonPairs()).entries()];
const popularPairs = ['ai-game-makers', 'ai-sprite-generators', 'ai-3d-model-generators', 'ai-coding-tools-for-game-dev', 'ai-music-generators-for-games', 'ai-voice-generators-for-games']
  .map((slug) => pairEntries.find(([, p]) => p.list.slug === slug))
  .filter((x) => x !== undefined)
  .concat(pairEntries.filter(([, p]) => p.list.slug === 'ai-game-makers').slice(1, 3))
  .slice(0, 8);

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: Astro.site!.toString(),
  description: SITE.description,
};
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: Astro.site!.toString(),
  logo: new URL('/favicon.svg', Astro.site).toString(),
};
---

<Base
  title={`${SITE.name}: Every Tool to Make Games with AI, Ranked (${SITE.year})`}
  description={`Want to make games with AI? We rank and compare ${live} AI game makers, sprite and 3D generators, coding assistants and audio tools on free tiers, pricing and commercial rights.`}
  jsonLd={[website, organization]}
>
  <section slot="hero" class="relative overflow-hidden border-b">
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,#000_60%,transparent_100%)] bg-[size:48px_48px] opacity-60"></div>
    <div class="from-brand/15 pointer-events-none absolute -top-40 left-1/2 h-[480px] w-[900px] -translate-x-1/2 rounded-full bg-radial to-transparent blur-3xl"></div>
    <div class="relative mx-auto flex max-w-4xl flex-col items-center px-4 py-20 text-center sm:px-6 sm:py-28">
      <Badge variant="outline" className="bg-background/80 mb-6 gap-1.5 rounded-full px-3 py-1 text-xs backdrop-blur">
        <span class="bg-success size-1.5 rounded-full"></span> {live} AI game dev tools, re-checked weekly
      </Badge>
      <h1 class="text-4xl font-bold sm:text-6xl sm:leading-[1.05]">
        Find the right AI tool to <span class="from-brand bg-gradient-to-r to-fuchsia-500 bg-clip-text text-transparent">make your game</span>
      </h1>
      <p class="text-muted-foreground mt-6 max-w-2xl text-lg leading-relaxed">
        Compare AI game makers, sprite and 3D generators, coding assistants and audio AI side by side. Prices, free plans,
        commercial rights and features, checked against each vendor's own site.
      </p>
      <div class="mt-9 w-full max-w-xl">
        <label class="relative block">
          <span class="sr-only">Search tools</span>
          <Search className="text-muted-foreground absolute top-1/2 left-4 size-5 -translate-y-1/2" />
          <input
            data-open-search
            readonly
            placeholder="Search tools, e.g. sprite generator, Unity, Meshy"
            class="bg-background h-14 w-full cursor-pointer rounded-xl border pr-20 pl-12 text-base shadow-lg outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
          />
          <kbd class="bg-muted text-muted-foreground absolute top-1/2 right-4 -translate-y-1/2 rounded border px-2 py-0.5 font-mono text-xs">⌘K</kbd>
        </label>
      </div>
      <div class="mt-5 flex flex-wrap justify-center gap-2">
        {[
          ['Make a game, no code', '/best/no-code-ai-game-makers'],
          ['2D games', '/best/2d-game-makers'],
          ['Sprites & pixel art', '/best/ai-sprite-generators'],
          ['3D models', '/best/ai-3d-model-generators'],
          ['Free tools', '/best/free-ai-game-dev-tools'],
        ].map(([label, href]) => (
          <a class={cn(buttonVariants({variant: 'outline', size: 'sm'}), 'bg-background/80 rounded-full backdrop-blur')} href={href}>{label}</a>
        ))}
      </div>
      <div class="text-muted-foreground mt-10 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
        <span class="inline-flex items-center gap-1.5"><ShieldCheck className="text-success size-4" /> Facts from vendor sites</span>
        <span class="inline-flex items-center gap-1.5"><Clock className="text-success size-4" /> Re-checked weekly</span>
        <span class="inline-flex items-center gap-1.5"><Scale className="text-success size-4" /> {pairs} head-to-heads</span>
        <a href="/methodology" class="hover:text-foreground inline-flex items-center gap-1.5 underline"><BadgeCheck className="text-success size-4" /> Public scoring method</a>
      </div>
    </div>
  </section>

  <SectionHeader title="Browse by category" href="/tools/" cta={`All ${live} tools`} />
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
    {
      catTiles.map(({ c, n }) => {
        const I = CATEGORY_ICONS[c];
        return (
          <a href={`/tools/?category=${c}`} class="group bg-card hover:border-foreground/20 flex items-center gap-3 rounded-xl border p-4 shadow-sm transition-all hover:shadow-md">
            <span class="bg-brand/10 text-brand grid size-10 shrink-0 place-items-center rounded-lg"><I className="size-5" /></span>
            <span class="min-w-0">
              <span class="block truncate text-sm font-medium">{CATEGORY_LABELS[c]}</span>
              <span class="text-muted-foreground text-xs">{n} tools</span>
            </span>
          </a>
        );
      })
    }
  </div>

  <SectionHeader title="Top pick in each category" description="The highest-scoring tool in six of our rankings." href="/best/" cta={`All ${lists.length} rankings`} />
  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {topPicks.map((p) => <ToolCard scored={p.top!} pick={`#1 ${p.label}`} />)}
  </ul>

  <SectionHeader title="Popular comparisons" href="/compare/" cta="Build your own" />
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {
      popularPairs.map(([slug, p]) => (
        <a href={`/compare/${slug}`} class="bg-card hover:border-foreground/20 flex items-center gap-3 rounded-xl border p-4 shadow-sm transition-all hover:shadow-md">
          <span class="flex -space-x-2">
            <ToolLogo name={p.a.data.name} url={p.a.data.url} size="sm" className="ring-background ring-2" />
            <ToolLogo name={p.b.data.name} url={p.b.data.url} size="sm" className="ring-background ring-2" />
          </span>
          <span class="min-w-0 text-sm font-medium leading-snug">{p.a.data.name} <span class="text-muted-foreground">vs</span> {p.b.data.name}</span>
        </a>
      ))
    }
  </div>

  <SectionHeader title="Three ways to make a game with AI" href="/guides/how-to-make-a-game-with-ai" cta="Step-by-step guide" />
  <div class="grid gap-5 md:grid-cols-3">
    {
      routes.map((r, i) => (
        <Card className="gap-4">
          <CardHeader>
            <span class="bg-primary text-primary-foreground font-display grid size-8 place-items-center rounded-full text-sm font-bold">{i + 1}</span>
            <CardTitle className="mt-2 text-lg">{r.title}</CardTitle>
            <CardDescription className="leading-relaxed">{r.body}</CardDescription>
          </CardHeader>
          <CardContent className="mt-auto space-y-4">
            <ul class="text-muted-foreground space-y-1.5 text-sm">{r.points.map((pt) => <li class="flex gap-2"><span class="text-brand">•</span>{pt}</li>)}</ul>
            <a class={buttonVariants({variant: 'outline', size: 'sm'})} href={r.href}>{r.cta} <ArrowRight /></a>
          </CardContent>
        </Card>
      ))
    }
  </div>

  <SectionHeader title="Every ranking" href="/best/" cta="See all" />
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      lists.map(({ def, ranked }) => {
        const I = LIST_ICON[def.slug] ?? Search;
        return (
          <a href={`/best/${def.slug}`} class="group bg-card hover:border-foreground/20 flex items-center gap-3 rounded-xl border p-4 shadow-sm transition-all hover:shadow-md">
            <span class="bg-muted grid size-10 shrink-0 place-items-center rounded-lg"><I className="size-5" /></span>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-medium">{def.title.replace(/^Best /, '')}</span>
              <span class="text-muted-foreground text-xs">{ranked.length} ranked · #1 {ranked[0].tool.data.name}</span>
            </span>
            <ArrowRight className="text-muted-foreground size-4 transition-transform group-hover:translate-x-0.5" />
          </a>
        );
      })
    }
  </div>

  <section class="bg-primary text-primary-foreground relative mt-20 overflow-hidden rounded-2xl px-6 py-12 sm:px-12">
    <div class="from-brand/40 pointer-events-none absolute -right-20 -bottom-24 size-80 rounded-full bg-radial to-transparent blur-2xl"></div>
    <div class="relative max-w-2xl">
      <h2 class="text-2xl font-semibold sm:text-3xl">Not sure where to start?</h2>
      <p class="text-primary-foreground/70 mt-3 leading-relaxed">
        Our step-by-step guide walks through picking a route, generating art and shipping your first game, with the tools that fit each step.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class={buttonVariants({variant: 'secondary'})} href="/guides/how-to-make-a-game-with-ai">Read the guide <ArrowRight /></a>
        <a class={cn(buttonVariants({variant: 'ghost'}), 'text-primary-foreground hover:bg-primary-foreground/10 hover:text-primary-foreground')} href="/methodology">How we rank</a>
      </div>
    </div>
  </section>
</Base>

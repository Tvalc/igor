---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { ScoreBars } from '../../components/site/ScoreBars';
import { ToolLogo } from '../../components/site/ToolLogo';
import { Stars } from '../../components/site/Stars';
import { ToolCard } from '../../components/site/ToolCard';
import { ProsCons } from '../../components/site/ProsCons';
import { FeatureMark } from '../../components/site/FeatureMark';
import { Plans } from '../../components/site/Plans';
import { Badge } from '../../components/ui/badge';
import { buttonVariants } from '../../components/ui/button';
import { Card, CardContent, CardHeader, CardTitle } from '../../components/ui/card';
import { cn } from '../../lib/utils';
import { ArrowRight, ArrowUpRight, Layers } from 'lucide-react';
import { featuresFor } from '../../lib/features';
import { alternativesFor, listsContaining, comparisonPairs } from '../../lib/lists';
import { scoreTool, groupOf, GROUP_LABELS, type Tool } from '../../lib/score';
import { softwareApp } from '../../lib/jsonld';
import {
  CATEGORY_LABELS, COMMERCIAL_LABELS, ENGINE_LABELS, EXPORT_LABELS, FREE_TIER_LABELS, STATUS_LABELS,
  isoDate, lc, list, outboundRel, outboundUrl, shown,
} from '../../lib/format';
import { fromPrice, priceHeadline, priceLabel } from '../../lib/compare';
import { SITE } from '../../site';
import { badgeFor } from '../../lib/badge';

export async function getStaticPaths() {
  return (await getCollection('tools')).map((tool) => ({ params: { slug: tool.id }, props: { tool } }));
}

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
const d = tool.data;
const base = Astro.site!.toString().replace(/\/$/, '');
const group = groupOf(tool);
const scored = scoreTool(tool, group);
const alternatives = await alternativesFor(tool, 4);
const inLists = await listsContaining(tool);
const comparisons = [...(await comparisonPairs()).entries()].filter(([, p]) => p.a.id === tool.id || p.b.id === tool.id);
const successor = d.successor ? await getEntry('tools', d.successor) : undefined;
const facts: [string, string, string | undefined][] = [
  ['Website', d.url.replace(/^https?:\/\//, '').replace(/\/$/, ''), undefined],
  ['Status', STATUS_LABELS[d.status], undefined],
  ['Free tier', FREE_TIER_LABELS[d.pricing.free_tier], undefined],
  ['Price', priceLabel(tool), d.plans.length ? undefined : d.pricing.notes],
  ['Commercial use', d.license.open_source ? `${shown(COMMERCIAL_LABELS[d.license.commercial_use])} · Open source` : COMMERCIAL_LABELS[d.license.commercial_use], d.license.notes],
  ['Engines', list(d.engines, ENGINE_LABELS), undefined],
  ['Exports', list(d.exports, EXPORT_LABELS), undefined],
  ['Runs on', list(d.platforms, { web: 'Web', desktop: 'Desktop', plugin: 'Plugin', api: 'API', cli: 'CLI', 'self-hosted': 'Self-hosted' }), undefined],
  ['Skill level', d.skill_level[0].toUpperCase() + d.skill_level.slice(1), undefined],
  ['Last verified', isoDate(d.last_verified), undefined],
];
const featureDefs = featuresFor(d.categories);
const compareIds = [tool.id, ...alternatives.slice(0, 2).map((s) => s.tool.id)];
const startPrice = fromPrice(tool);
const headline = priceHeadline(tool);
const dead = d.status === 'discontinued';
const badge = dead ? undefined : await badgeFor(tool);
const badgeCode = badge && `<a href="${base}/tools/${tool.id}"><img src="${base}/badges/${tool.id}.svg" alt="${badge.alt}" height="28"></a>`;
const correction = `mailto:${SITE.contact}?subject=${encodeURIComponent(`Correction: ${d.name}`)}&body=${encodeURIComponent(`Page: ${base}/tools/${tool.id}\n\nWhat is wrong:\n\nWhat it should say:\n\nPrimary source (link):\n`)}`;
const title = d.status === 'discontinued' ? `${d.name}: discontinued, and what to use instead` : `${d.name} Review (${SITE.year}): Pricing & Alternatives`;
---

<Base
  title={title}
  description={`${d.name}: ${d.tagline} Pricing, commercial rights, exports and our ${scored.score}/100 score, plus the best alternatives.`}
  crumbs={[{ name: 'Tools', href: '/tools/' }, { name: d.name, href: `/tools/${tool.id}` }]}
  markdownPath={`/tools/${tool.id}.md`}
  jsonLd={dead ? [] : [softwareApp(scored, base)]}
>
  <section class="bg-card mt-6 grid gap-6 rounded-2xl border p-6 shadow-sm sm:p-8 md:grid-cols-[auto_1fr_auto] md:items-center">
    <ToolLogo name={d.name} url={d.url} size="lg" />
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-3xl font-bold sm:text-4xl">{d.name}</h1>
        {d.makko_owned && <Badge variant="outline" className="border-amber-400/60 text-amber-700 dark:text-amber-300">Built by our team</Badge>}
        {d.status !== 'active' && <Badge variant={dead ? 'destructive' : 'secondary'}>{STATUS_LABELS[d.status]}</Badge>}
      </div>
      <p class="text-muted-foreground mt-2 text-lg">{d.tagline}</p>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        {!dead && <Stars score={scored.score} className="mr-2" />}
        {d.categories.map((c) => <Badge variant="secondary">{CATEGORY_LABELS[c]}</Badge>)}
      </div>
    </div>
    {
      !dead && (
        <div class="flex flex-col gap-3 md:min-w-52 md:items-stretch md:text-center">
          <div>
            <div class="font-display text-2xl font-semibold">{priceLabel(tool) === 'Unverified' ? <span class="text-muted-foreground text-base font-normal">{headline.main}</span> : headline.main}</div>
            <div class="text-muted-foreground text-xs">{headline.sub}</div>
          </div>
          <a class={buttonVariants({ size: 'lg' })} href={outboundUrl(tool)} rel={outboundRel(tool)} target="_blank">Visit {d.name} <ArrowUpRight /></a>
          <label class="text-muted-foreground flex cursor-pointer items-center justify-center gap-2 text-sm">
            <input type="checkbox" data-compare={tool.id} class="accent-brand size-4" /> Add to compare
          </label>
        </div>
      )
    }
  </section>

  {
    d.makko_owned && (
      <p class="notice mt-4">
        Disclosure: {SITE.name} is run by {SITE.owner}. {d.name} is scored exactly the same way as every other tool. <a class="underline" href="/disclosure">Read our disclosure</a>.
      </p>
    )
  }

  <nav class="bg-background/90 sticky top-16 z-30 -mx-4 mt-6 overflow-x-auto border-b px-4 backdrop-blur sm:-mx-6 sm:px-6" aria-label="On this page">
    <div class="flex gap-1 py-2">
      {[
        ['overview', 'Overview', true],
        ['pricing', 'Pricing', d.plans.length > 0 || !!d.pricing.notes],
        ['features', 'Features', featureDefs.length > 0 && !dead],
        ['score', 'Score', !dead],
        ['alternatives', 'Alternatives', alternatives.length > 0],
        ['compare', 'Compare', !dead && (comparisons.length > 0 || alternatives.length > 0)],
        ['sources', 'Sources', d.sources.length > 0],
      ].filter((x) => x[2]).map(([id, label]) => (
        <a href={`#${id}`} class="text-muted-foreground hover:text-foreground hover:bg-accent rounded-md px-3 py-1.5 text-sm font-medium whitespace-nowrap">{label}</a>
      ))}
    </div>
  </nav>

  <div class="mt-8 grid gap-10 lg:grid-cols-[1fr_320px]">
    <div class="min-w-0 space-y-14">
      <section id="overview" class="scroll-mt-32">
        <h2 class="mb-4 text-2xl font-semibold">Overview</h2>
        <div class="answer">
          <p>
            {
              dead ? (
                <>
                  {d.description} {successor && <>Its replacement is <a class="underline" href={`/tools/${successor.id}`}>{successor.data.name}</a>.</>}
                </>
              ) : (
                <>
                  <strong>{d.name}</strong>: {d.tagline} It scores <strong>{scored.score}/100</strong> in our {lc(GROUP_LABELS[group])} ranking. Best for: {d.best_for}
                </>
              )
            }
          </p>
        </div>
        {!dead && <p class="leading-7">{d.description}</p>}
        {!dead && (
          <Card className="mt-6 py-5">
            <CardContent className="px-5"><ProsCons tool={tool} max={6} /></CardContent>
          </Card>
        )}
      </section>

      {
        (d.plans.length > 0 || d.pricing.notes) && (
          <section id="pricing" class="scroll-mt-32">
            <h2 class="mb-4 text-2xl font-semibold">{d.name} pricing</h2>
            {d.plans.length > 0 ? <Plans tool={tool} /> : <p class="text-muted-foreground">{d.pricing.notes}</p>}
            <p class="text-muted-foreground mt-3 text-sm">Monthly prices in USD as listed by {d.name}. Last checked {isoDate(d.last_verified)}.{d.license.notes && <> Rights: {d.license.notes}</>}</p>
          </section>
        )
      }

      {
        featureDefs.length > 0 && !dead && (
          <section id="features" class="scroll-mt-32">
            <h2 class="mb-4 text-2xl font-semibold">Features</h2>
            <Card className="py-2">
              <ul class="divide-y px-5">
                {featureDefs.map((f) => (
                  <li class="flex items-start justify-between gap-4 py-3 text-sm">
                    <span>
                      {f.label}
                      {d.feature_notes[f.key] && <span class="text-muted-foreground block text-xs">{d.feature_notes[f.key]}</span>}
                    </span>
                    <FeatureMark value={d.features[f.key]} />
                  </li>
                ))}
              </ul>
            </Card>
            <p class="text-muted-foreground mt-3 text-sm">Checked against {d.name}'s own site, docs and pricing page. <a class="underline" href="/methodology">How we check</a></p>
          </section>
        )
      }

      {
        !dead && (
          <section id="score" class="scroll-mt-32">
            <h2 class="mb-4 text-2xl font-semibold">Score breakdown: {scored.score}/100</h2>
            <Card className="py-6"><CardContent className="px-6"><ScoreBars scored={scored} group={group} /></CardContent></Card>
            <p class="text-muted-foreground mt-3 text-sm">
              {scored.handsOn ? <>Includes our hands-on test ({d.hands_on!.score}/10).</> : <>Based on price, free plan, commercial rights, exports and features.</>}{' '}
              <a class="underline" href="/methodology">How we score</a>
            </p>
            {inLists.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-2">
                {inLists.map(({ def, ranked }) => (
                  <a href={`/best/${def.slug}`} class={buttonVariants({ variant: 'outline', size: 'sm' })}>
                    <span class="font-semibold">#{ranked.findIndex((s) => s.tool.id === tool.id) + 1}</span> {def.title.replace(/^Best /, '')}
                  </a>
                ))}
              </div>
            )}
          </section>
        )
      }

      {
        alternatives.length > 0 && (
          <section id="alternatives" class="scroll-mt-32">
            <div class="mb-4 flex flex-wrap items-end justify-between gap-2">
              <h2 class="text-2xl font-semibold">{d.name} alternatives</h2>
              {alternatives.length >= 3 && <a class="text-brand inline-flex items-center gap-1 text-sm font-medium hover:underline" href={`/alternatives/${tool.id}`}>All alternatives <ArrowRight className="size-4" /></a>}
            </div>
            <ul class="grid gap-5 sm:grid-cols-2">{alternatives.map((s) => <ToolCard scored={s} />)}</ul>
          </section>
        )
      }

      {
        !dead && (comparisons.length > 0 || alternatives.length > 0) && (
          <section id="compare" class="scroll-mt-32">
            <h2 class="mb-4 text-2xl font-semibold">Compare {d.name}</h2>
            {alternatives.length > 0 && (
              <a class={buttonVariants({ variant: 'default' })} href={`/compare/?tools=${compareIds.join(',')}`}>
                <Layers /> Compare with {alternatives.slice(0, 2).map((s) => s.tool.data.name).join(' and ')}
              </a>
            )}
            {comparisons.length > 0 && (
              <div class="mt-4 grid gap-2 sm:grid-cols-2">
                {comparisons.map(([slug, p]) => (
                  <a href={`/compare/${slug}`} class="bg-card hover:bg-accent flex items-center justify-between rounded-lg border px-4 py-3 text-sm font-medium">
                    {p.a.data.name} vs {p.b.data.name} <ArrowRight className="text-muted-foreground size-4" />
                  </a>
                ))}
              </div>
            )}
          </section>
        )
      }

      {
        d.sources.length > 0 && (
          <section id="sources" class="scroll-mt-32">
            <h2 class="mb-4 text-2xl font-semibold">Sources</h2>
            <ul class="text-muted-foreground space-y-1.5 text-sm break-all">
              {d.sources.map((u) => <li><a class="hover:text-foreground underline" href={u} rel="nofollow noopener">{u}</a></li>)}
            </ul>
          </section>
        )
      }

      <section id="corrections" class="bg-muted/30 scroll-mt-32 rounded-xl border p-5 text-sm">
        <h2 class="mb-2 text-lg font-semibold">Something wrong or out of date?</h2>
        <p class="text-muted-foreground">
          We fix verified errors within a week and log them in the <a class="underline" href="/changelog">changelog</a>.
          <a class="text-brand font-medium hover:underline" href={correction}>Send a correction</a> with a link to a primary source.
          See our <a class="underline" href="/editorial-policy">editorial policy</a>.
        </p>
        {badge && badgeCode && (
          <details class="mt-4">
            <summary class="cursor-pointer font-medium">Work on {d.name}? Embed your badge</summary>
            <p class="text-muted-foreground mt-3"><img src={`/badges/${tool.id}.svg`} alt={badge.alt} height="28" loading="lazy" /></p>
            <p class="text-muted-foreground mt-3">Paste this into your site or README. It updates when your ranking changes. <a class="underline" href="/badges">About badges</a></p>
            <pre class="bg-background mt-2 overflow-x-auto rounded-md border p-3 text-xs"><code>{badgeCode}</code></pre>
          </details>
        )}
      </section>
    </div>

    <aside class="lg:sticky lg:top-32 lg:self-start">
      <Card className="gap-4 py-5">
        <CardHeader className="px-5"><CardTitle>At a glance</CardTitle></CardHeader>
        <CardContent className="px-5">
          <dl class="divide-y text-sm">
            {facts.map(([label, value, note]) => (
              <div class="grid grid-cols-[7rem_1fr] gap-3 py-2.5">
                <dt class="text-muted-foreground">{label}</dt>
                <dd class={cn('min-w-0 font-medium break-words', value === 'Unverified' && 'text-muted-foreground font-normal')}>
                  {label === 'Website' ? <a class="text-brand hover:underline" href={d.url} rel="noopener">{value}</a> : shown(value, label === 'Price' ? 'price' : 'fact')}
                  {note && <span class="text-muted-foreground mt-1 block text-xs font-normal">{note}</span>}
                </dd>
              </div>
            ))}
          </dl>
        </CardContent>
      </Card>
    </aside>
  </div>
</Base>

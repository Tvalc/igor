---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ScoreBars from '../../components/ScoreBars.astro';
import Monogram from '../../components/Monogram.astro';
import ScoreRing from '../../components/ScoreRing.astro';
import RankTable from '../../components/RankTable.astro';
import { alternativesFor, listsContaining, comparisonPairs } from '../../lib/lists';
import { scoreTool, groupOf, GROUP_LABELS, type Tool } from '../../lib/score';
import { softwareApp } from '../../lib/jsonld';
import {
  CATEGORY_LABELS, COMMERCIAL_LABELS, ENGINE_LABELS, FREE_TIER_LABELS, STATUS_LABELS,
  isoDate, list, outboundRel, outboundUrl, price,
} from '../../lib/format';
import { SITE } from '../../site';

export async function getStaticPaths() {
  return (await getCollection('tools')).map((tool) => ({ params: { slug: tool.id }, props: { tool } }));
}

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
const d = tool.data;
const base = Astro.site!.toString().replace(/\/$/, '');
const group = groupOf(tool);
const scored = scoreTool(tool, group);
const alternatives = await alternativesFor(tool, 5);
const inLists = await listsContaining(tool);
const comparisons = [...(await comparisonPairs()).entries()].filter(([, p]) => p.a.id === tool.id || p.b.id === tool.id);
const successor = d.successor ? await getEntry('tools', d.successor) : undefined;
const facts: [string, string, string | undefined][] = [
  ['Website', d.url.replace(/^https?:\/\//, ''), undefined],
  ['Status', STATUS_LABELS[d.status], undefined],
  ['Free tier', FREE_TIER_LABELS[d.pricing.free_tier], undefined],
  ['Price', price(tool), d.pricing.notes],
  ['Commercial use', COMMERCIAL_LABELS[d.license.commercial_use] + (d.license.open_source ? ' · Open source' : ''), d.license.notes],
  ['Engines', list(d.engines, ENGINE_LABELS), undefined],
  ['Exports', list(d.exports), undefined],
  ['Runs on', list(d.platforms, { web: 'Web', desktop: 'Desktop', plugin: 'Plugin', api: 'API', cli: 'CLI', 'self-hosted': 'Self-hosted' }), undefined],
  ['Skill level', d.skill_level[0].toUpperCase() + d.skill_level.slice(1), undefined],
  ['Last verified', isoDate(d.last_verified), undefined],
];
const title = d.status === 'discontinued' ? `${d.name}: discontinued, and what to use instead` : `${d.name} Review (${SITE.year}): Pricing, Features & Alternatives`;
---

<Base
  title={title}
  description={`${d.name}: ${d.tagline} Pricing, commercial rights, exports and our ${scored.score}/100 score, plus the best alternatives.`}
  crumbs={[{ name: 'Tools', href: '/tools/' }, { name: d.name, href: `/tools/${tool.id}` }]}
  markdownPath={`/tools/${tool.id}.md`}
  jsonLd={d.status === 'discontinued' ? [] : [softwareApp(scored, base)]}
>
  <div class="tool-hero">
    <Monogram name={d.name} size="lg" />
    <div>
      <h1>{d.name}</h1>
      <p class="tagline">{d.tagline}</p>
      <p style="margin:8px 0 0">
        {d.categories.map((c) => <span class="pill">{CATEGORY_LABELS[c]}</span>)}
        {d.status !== 'active' && <span class={`pill ${d.status === 'discontinued' ? 'dead' : ''}`}>{STATUS_LABELS[d.status]}</span>}
        {d.makko_owned && <span class="pill owned">Built by our team</span>}
      </p>
    </div>
    {d.status !== 'discontinued' && <ScoreRing score={scored.score} size={84} label />}
  </div>

  <div class="answer">
    <p>
      {
        d.status === 'discontinued' ? (
          <>
            {d.description}{' '}
            {successor && (
              <>
                Its replacement is <a href={`/tools/${successor.id}`}>{successor.data.name}</a>.
              </>
            )}
          </>
        ) : (
          <>
            <strong>{d.name}</strong>: {d.tagline} It scores <strong>{scored.score}/100</strong> on our{' '}
            {GROUP_LABELS[group]} rubric. Best for: {d.best_for}
          </>
        )
      }
    </p>
  </div>

  {
    d.makko_owned && (
      <p class="notice">
        Disclosure: {SITE.name} is run by {SITE.owner}. {d.name} is scored by exactly the same rubric and data rules as
        every other tool. <a href="/disclosure">Read our disclosure</a>.
      </p>
    )
  }

  {
    d.status !== 'discontinued' && (
      <p>
        <a class="btn" href={outboundUrl(tool)} rel={outboundRel(tool)} target="_blank">
          Visit {d.name}
        </a>
        {d.affiliate?.url && <span class="meta"> Affiliate link</span>}
      </p>
    )
  }

  <h2>What it is</h2>
  <p>{d.description}</p>

  <h2>Key facts</h2>
  <dl class="facts-grid">
    {facts.map(([label, value, note]) => (
      <div class="fact">
        <dt>{label}</dt>
        <dd class={value === 'Unverified' ? 'unverified' : undefined}>
          {label === 'Website' ? <a href={d.url} rel="noopener">{value}</a> : value}
          {note && <span class="meta"> ({note})</span>}
        </dd>
      </div>
    ))}
  </dl>
  {
    d.needs_verification.length > 0 && (
      <p class="meta">
        Still being verified against primary sources: {d.needs_verification.join(', ')}. "Unverified" means we haven't
        confirmed it, not that the feature is missing.
      </p>
    )
  }

  {
    d.status !== 'discontinued' && (
      <>
        <h2>Score breakdown: {scored.score}/100</h2>
        <ScoreBars scored={scored} group={group} />
        <p class="meta">
          {scored.handsOn ? (
            <>Includes our hands-on test ({d.hands_on!.score}/10).</>
          ) : (
            <>Facts-based score. A hands-on test hasn't been published yet.</>
          )}{' '}
          <a href="/methodology">How scores work</a>
        </p>
      </>
    )
  }

  {
    inLists.length > 0 && (
      <>
        <h2>Where {d.name} ranks</h2>
        <ul>
          {inLists.map(({ def, ranked }) => (
            <li>
              #{ranked.findIndex((s) => s.tool.id === tool.id) + 1} of {ranked.length} in{' '}
              <a href={`/best/${def.slug}`}>{def.title}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    alternatives.length > 0 && (
      <>
        <h2>Top {d.name} alternatives</h2>
        <RankTable ranked={alternatives} />
        {alternatives.length >= 3 && <p><a href={`/alternatives/${tool.id}`}>All {d.name} alternatives →</a></p>}
      </>
    )
  }

  {
    comparisons.length > 0 && (
      <>
        <h2>Compare {d.name}</h2>
        <ul>
          {comparisons.map(([slug, p]) => (
            <li>
              <a href={`/compare/${slug}`}>
                {p.a.data.name} vs {p.b.data.name}
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    d.sources.length > 0 && (
      <>
        <h2>Sources</h2>
        <ul class="meta">
          {d.sources.map((u) => (
            <li>
              <a href={u} rel="nofollow noopener">{u}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Base>

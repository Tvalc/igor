---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ScoreBars from '../../components/ScoreBars.astro';
import ToolLogo from '../../components/ToolLogo.astro';
import Stars from '../../components/Stars.astro';
import ToolCard from '../../components/ToolCard.astro';
import ProsCons from '../../components/ProsCons.astro';
import FeatureMark from '../../components/FeatureMark.astro';
import Plans from '../../components/Plans.astro';
import Icon from '../../components/Icon.astro';
import { featuresFor } from '../../lib/features';
import { alternativesFor, listsContaining, comparisonPairs } from '../../lib/lists';
import { scoreTool, groupOf, GROUP_LABELS, type Tool } from '../../lib/score';
import { softwareApp } from '../../lib/jsonld';
import {
  CATEGORY_LABELS, COMMERCIAL_LABELS, ENGINE_LABELS, EXPORT_LABELS, FREE_TIER_LABELS, STATUS_LABELS,
  isoDate, lc, list, outboundRel, outboundUrl, shown,
} from '../../lib/format';
import { fromPrice, priceLabel } from '../../lib/compare';
import { SITE } from '../../site';

export async function getStaticPaths() {
  return (await getCollection('tools')).map((tool) => ({ params: { slug: tool.id }, props: { tool } }));
}

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
const d = tool.data;
const base = Astro.site!.toString().replace(/\/$/, '');
const group = groupOf(tool);
const scored = scoreTool(tool, group);
const alternatives = await alternativesFor(tool, 4);
const inLists = await listsContaining(tool);
const comparisons = [...(await comparisonPairs()).entries()].filter(([, p]) => p.a.id === tool.id || p.b.id === tool.id);
const successor = d.successor ? await getEntry('tools', d.successor) : undefined;
const facts: [string, string, string | undefined][] = [
  ['Website', d.url.replace(/^https?:\/\//, '').replace(/\/$/, ''), undefined],
  ['Status', STATUS_LABELS[d.status], undefined],
  ['Free tier', FREE_TIER_LABELS[d.pricing.free_tier], undefined],
  ['Price', priceLabel(tool), d.plans.length ? undefined : d.pricing.notes],
  ['Commercial use', d.license.open_source ? `${shown(COMMERCIAL_LABELS[d.license.commercial_use])} · Open source` : COMMERCIAL_LABELS[d.license.commercial_use], d.license.notes],
  ['Engines', list(d.engines, ENGINE_LABELS), undefined],
  ['Exports', list(d.exports, EXPORT_LABELS), undefined],
  ['Runs on', list(d.platforms, { web: 'Web', desktop: 'Desktop', plugin: 'Plugin', api: 'API', cli: 'CLI', 'self-hosted': 'Self-hosted' }), undefined],
  ['Skill level', d.skill_level[0].toUpperCase() + d.skill_level.slice(1), undefined],
  ['Last verified', isoDate(d.last_verified), undefined],
];
const featureDefs = featuresFor(d.categories);
const compareIds = [tool.id, ...alternatives.slice(0, 2).map((s) => s.tool.id)];
const startPrice = fromPrice(tool);
const dead = d.status === 'discontinued';
const title = d.status === 'discontinued' ? `${d.name}: discontinued, and what to use instead` : `${d.name} Review (${SITE.year}): Pricing, Features & Alternatives`;
---

<Base
  title={title}
  description={`${d.name}: ${d.tagline} Pricing, commercial rights, exports and our ${scored.score}/100 score, plus the best alternatives.`}
  crumbs={[{ name: 'Tools', href: '/tools/' }, { name: d.name, href: `/tools/${tool.id}` }]}
  markdownPath={`/tools/${tool.id}.md`}
  jsonLd={dead ? [] : [softwareApp(scored, base)]}
>
  <section class="product-head">
    <ToolLogo name={d.name} url={d.url} size="lg" />
    <div>
      <h1>{d.name}</h1>
      <p class="tagline">{d.tagline}</p>
      <div class="product-meta">
        {!dead && <Stars score={scored.score} />}
        {d.categories.map((c) => <span class="pill">{CATEGORY_LABELS[c]}</span>)}
        {d.status !== 'active' && <span class={`pill ${dead ? 'dead' : ''}`}>{STATUS_LABELS[d.status]}</span>}
        {d.makko_owned && <span class="pill owned">Built by our team</span>}
      </div>
    </div>
    {
      !dead && (
        <div class="product-cta">
          <div class="price-big">
            {priceLabel(tool) === 'Unverified' ? <span class="unverified">{shown('Unverified', 'price')}</span> : priceLabel(tool)}
            <small>{priceLabel(tool) === 'Free plan' ? '' : d.pricing.free_tier === 'yes' ? 'Free plan available' : startPrice ? 'starting price' : ''}</small>
          </div>
          <a class="btn" href={outboundUrl(tool)} rel={outboundRel(tool)} target="_blank">Visit {d.name} <Icon name="external" size={16} /></a>
          <label class="tcard-cmp" style="justify-content:center"><input type="checkbox" data-compare={tool.id} /> Add to compare</label>
          {d.affiliate?.url && <span class="meta">Affiliate link</span>}
        </div>
      )
    }
  </section>

  {
    d.makko_owned && (
      <p class="notice">
        Disclosure: {SITE.name} is run by {SITE.owner}. {d.name} is scored exactly the same way as
        every other tool. <a href="/disclosure">Read our disclosure</a>.
      </p>
    )
  }

  <nav class="tabs" aria-label="On this page">
    <a href="#overview">Overview</a>
    {(d.plans.length > 0 || d.pricing.notes) && <a href="#pricing">Pricing</a>}
    {featureDefs.length > 0 && !dead && <a href="#features">Features</a>}
    {!dead && <a href="#score">Score</a>}
    {alternatives.length > 0 && <a href="#alternatives">Alternatives</a>}
    {comparisons.length > 0 && <a href="#compare">Compare</a>}
    {d.sources.length > 0 && <a href="#sources">Sources</a>}
  </nav>

  <div class="product-body">
    <div>
      <section id="overview">
        <h2>Overview</h2>
        <div class="answer">
          <p>
            {
              dead ? (
                <>
                  {d.description}{' '}
                  {successor && (
                    <>
                      Its replacement is <a href={`/tools/${successor.id}`}>{successor.data.name}</a>.
                    </>
                  )}
                </>
              ) : (
                <>
                  <strong>{d.name}</strong>: {d.tagline} It scores <strong>{scored.score}/100</strong> on our{' '}
                  {lc(GROUP_LABELS[group])} ranking. Best for: {d.best_for}
                </>
              )
            }
          </p>
        </div>
        {!dead && <p>{d.description}</p>}
        {!dead && <ProsCons tool={tool} max={6} />}
      </section>

      {
        (d.plans.length > 0 || d.pricing.notes) && (
          <section id="pricing">
            <h2>{d.name} pricing</h2>
            {d.plans.length > 0 ? <Plans tool={tool} /> : <p>{d.pricing.notes}</p>}
            <p class="meta">
              Monthly prices in USD as listed by {d.name}. Last checked {isoDate(d.last_verified)}.
              {d.license.notes && <> Rights: {d.license.notes}</>}
            </p>
          </section>
        )
      }

      {
        featureDefs.length > 0 && !dead && (
          <section id="features">
            <h2>Features</h2>
            <ul class="feature-list">
              {featureDefs.map((f) => (
                <li>
                  <span>
                    {f.label}
                    {d.feature_notes[f.key] && <span class="note"> ({d.feature_notes[f.key]})</span>}
                  </span>
                  <FeatureMark value={d.features[f.key]} />
                </li>
              ))}
            </ul>
            <p class="meta">Checked against {d.name}'s own site, docs and pricing page. <a href="/methodology">How we check</a></p>
          </section>
        )
      }

      {
        !dead && (
          <section id="score">
            <h2>Score breakdown: {scored.score}/100</h2>
            <ScoreBars scored={scored} group={group} />
            <p class="meta">
              {scored.handsOn ? <>Includes our hands-on test ({d.hands_on!.score}/10).</> : <>Based on price, free plan, commercial rights, exports and features.</>}{' '}
              <a href="/methodology">How we score</a>
            </p>
            {inLists.length > 0 && (
              <>
                <h3>Where {d.name} ranks</h3>
                <ul>
                  {inLists.map(({ def, ranked }) => (
                    <li>
                      #{ranked.findIndex((s) => s.tool.id === tool.id) + 1} of {ranked.length} in{' '}
                      <a href={`/best/${def.slug}`}>{def.title}</a>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </section>
        )
      }

      {
        alternatives.length > 0 && (
          <section id="alternatives">
            <h2>{d.name} alternatives</h2>
            <ul class="tool-grid">{alternatives.map((s) => <ToolCard scored={s} />)}</ul>
            {alternatives.length >= 3 && <p><a href={`/alternatives/${tool.id}`}>All {d.name} alternatives →</a></p>}
          </section>
        )
      }

      {
        (comparisons.length > 0 || alternatives.length > 0) && !dead && (
          <section id="compare">
            <h2>Compare {d.name}</h2>
            {alternatives.length > 0 && (
              <p>
                <a class="btn btn-ghost" href={`/compare/?tools=${compareIds.join(',')}`}>
                  Compare with {alternatives.slice(0, 2).map((s) => s.tool.data.name).join(' and ')}
                </a>
              </p>
            )}
            {comparisons.length > 0 && (
              <ul>
                {comparisons.map(([slug, p]) => (
                  <li><a href={`/compare/${slug}`}>{p.a.data.name} vs {p.b.data.name}</a></li>
                ))}
              </ul>
            )}
          </section>
        )
      }

      {
        d.sources.length > 0 && (
          <section id="sources">
            <h2>Sources</h2>
            <ul class="meta">
              {d.sources.map((u) => (
                <li><a href={u} rel="nofollow noopener">{u}</a></li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <aside class="card glance" aria-labelledby="glance-h">
      <h2 id="glance-h">At a glance</h2>
      <dl>
        {facts.map(([label, value, note]) => (
          <div>
            <dt>{label}</dt>
            <dd class={value === 'Unverified' ? 'unverified' : undefined}>
              {label === 'Website' ? <a href={d.url} rel="noopener">{value}</a> : shown(value, label === 'Price' ? 'price' : 'fact')}
              {note && <span class="note">{note}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </aside>
  </div>
</Base>

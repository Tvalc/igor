---
import FeatureMark from './FeatureMark.astro';
import type { Tool } from '../lib/score';
import type { FeatureDef } from '../lib/features';

interface Props {
  tools: Tool[];
  defs: FeatureDef[];
}
const { tools, defs } = Astro.props;
// Hide rows nobody has data for, so the table shows what we know rather than a wall of question marks.
const rows = defs.filter((f) => tools.some((t) => t.data.features[f.key] !== undefined));
---

{
  rows.length > 0 && (
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Feature</th>
            {tools.map((t) => <th><a href={`/tools/${t.id}`}>{t.data.name}</a></th>)}
          </tr>
        </thead>
        <tbody>
          {rows.map((f) => (
            <tr>
              <td>{f.label}</td>
              {tools.map((t) => (
                <td>
                  <FeatureMark value={t.data.features[f.key]} note={t.data.feature_notes[f.key]} />
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}

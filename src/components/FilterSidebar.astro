---
// Left-hand filters for listing pages. Counts are for the whole list, like most comparison sites show them.
import type { Scored } from '../lib/score';
import { fromPrice } from '../lib/compare';
import { CATEGORY_LABELS, ENGINE_LABELS, EXPORT_LABELS } from '../lib/format';
import { CATEGORIES, ENGINES, EXPORTS } from '../content.config';

interface Props {
  items: Scored[];
  showCategory?: boolean;
  showSearch?: boolean;
}
const { items, showCategory = true, showSearch = true } = Astro.props;
const tools = items.map((s) => s.tool.data);
const n = (f: (d: (typeof tools)[number]) => boolean) => tools.filter(f).length;
const cats = CATEGORIES.map((c) => [c, n((d) => (d.categories as string[]).includes(c))] as const).filter(([, k]) => k > 0);
const engines = ENGINES.filter((e) => n((d) => (d.engines as string[]).includes(e)) > 0);
const exportsUsed = EXPORTS.filter((e) => n((d) => (d.exports as string[]).includes(e)) > 0);
const prices = items.map((s) => fromPrice(s.tool));
const priceCount = (max: number) => prices.filter((p) => p !== null && p <= max).length;
---

<form class="sidebar" id="filters" aria-label="Filters">
  <div class="sidebar-head">
    <h2>Filters</h2>
    <span>
      <button type="button" class="link-btn" data-reset>Reset</button>
      <button type="button" class="link-btn close-filters" data-close-filters aria-label="Close filters">Done</button>
    </span>
  </div>
  {
    showSearch && (
      <fieldset>
        <legend>Search</legend>
        <input type="search" name="q" placeholder="Name or keyword" aria-label="Search within results" />
      </fieldset>
    )
  }
  {
    showCategory && (
      <fieldset>
        <legend>Category</legend>
        <label><input type="radio" name="cat" value="" checked /> <span class="label">All categories</span> <span class="count">{tools.length}</span></label>
        {cats.map(([c, k]) => (
          <label><input type="radio" name="cat" value={c} /> <span class="label">{CATEGORY_LABELS[c]}</span> <span class="count">{k}</span></label>
        ))}
      </fieldset>
    )
  }
  <fieldset>
    <legend>Price</legend>
    <label><input type="radio" name="price" value="" checked /> <span class="label">Any price</span></label>
    <label><input type="radio" name="price" value="free" /> <span class="label">Has a free plan</span> <span class="count">{n((d) => ['yes', 'limited'].includes(d.pricing.free_tier))}</span></label>
    <label><input type="radio" name="price" value="10" /> <span class="label">From $10/mo or less</span> <span class="count">{priceCount(10)}</span></label>
    <label><input type="radio" name="price" value="25" /> <span class="label">From $25/mo or less</span> <span class="count">{priceCount(25)}</span></label>
    <label><input type="radio" name="price" value="50" /> <span class="label">From $50/mo or less</span> <span class="count">{priceCount(50)}</span></label>
  </fieldset>
  <fieldset>
    <legend>Rights &amp; skill</legend>
    <label><input type="checkbox" name="commercial" /> <span class="label">Commercial use allowed</span> <span class="count">{n((d) => ['yes', 'paid-plans'].includes(d.license.commercial_use))}</span></label>
    <label><input type="checkbox" name="beginner" /> <span class="label">Beginner friendly</span> <span class="count">{n((d) => d.skill_level === 'beginner')}</span></label>
  </fieldset>
  {
    engines.length > 0 && (
      <fieldset>
        <legend>Engine</legend>
        <select name="engine" aria-label="Engine">
          <option value="">Any engine</option>
          {engines.map((e) => <option value={e}>{ENGINE_LABELS[e]}</option>)}
        </select>
      </fieldset>
    )
  }
  {
    exportsUsed.length > 0 && (
      <fieldset>
        <legend>Exports</legend>
        <select name="export" aria-label="Export format">
          <option value="">Any format</option>
          {exportsUsed.map((e) => <option value={e}>{EXPORT_LABELS[e]}</option>)}
        </select>
      </fieldset>
    )
  }
</form>

---
interface Props {
  faqs: { q: string; a: string }[];
}
const { faqs } = Astro.props;
---

<section class="faq">
  <h2>Frequently asked questions</h2>
  {
    faqs.map((f, i) => (
      <details open={i === 0}>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</section>

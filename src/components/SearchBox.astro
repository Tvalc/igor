---
// Instant tool search. Reads the #search-data JSON that Base embeds once per page.
import Icon from './Icon.astro';

interface Props {
  variant?: 'header' | 'hero';
  placeholder?: string;
}
const { variant = 'header', placeholder = 'Search AI game tools' } = Astro.props;
const id = `search-${variant}`;
---

<form class={`search search-${variant}`} role="search" action="/tools/" data-search>
  <label class="visually-hidden" for={id}>Search tools</label>
  <span class="search-ico"><Icon name="search" size={variant === 'hero' ? 22 : 18} /></span>
  <input
    id={id}
    class="search-input"
    type="search"
    name="q"
    placeholder={placeholder}
    autocomplete="off"
    role="combobox"
    aria-expanded="false"
    aria-controls={`${id}-results`}
    aria-autocomplete="list"
  />
  <ul class="search-results" id={`${id}-results`} role="listbox" hidden></ul>
</form>

<script>
  import { siteLinks, logoSrc } from '../lib/links';

  type Item = { id: string; name: string; cat: string; price: string; host: string; text: string };
  const raw = document.getElementById('search-data')?.textContent;
  const items: Item[] = raw ? JSON.parse(raw) : [];
  const links = siteLinks();
  const mono = (name: string) => {
    let h = 0;
    for (const ch of name) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
    const w = name.replace(/\(.*?\)/g, '').split(/[\s.\-&]+/).filter(Boolean);
    const ini = (w.length > 1 ? w[0][0] + w[1][0] : name.slice(0, 2)).toUpperCase();
    return `<span class="mono mono-sm" style="--h:${h % 360}">${ini}</span>`;
  };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function rank(q: string) {
    const scored = items
      .map((t) => {
        const n = t.name.toLowerCase();
        const s = n.startsWith(q) ? 3 : n.includes(q) ? 2 : t.text.includes(q) ? 1 : 0;
        return { t, s };
      })
      .filter((x) => x.s > 0)
      .sort((a, b) => b.s - a.s || a.t.name.localeCompare(b.t.name));
    return scored.map((x) => x.t);
  }

  document.querySelectorAll<HTMLFormElement>('form[data-search]').forEach((form) => {
    const input = form.querySelector('input')!;
    const list = form.querySelector('ul')!;
    let active = -1;
    let results: Item[] = [];

    const close = () => {
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      active = -1;
    };
    const paint = () => {
      list.querySelectorAll('li[data-i]').forEach((li) => li.setAttribute('aria-selected', String(Number((li as HTMLElement).dataset.i) === active)));
    };
    const render = () => {
      const q = input.value.trim().toLowerCase();
      if (!q) return close();
      results = rank(q).slice(0, 7);
      list.innerHTML =
        (results.length
          ? results
              .map(
                (t, i) => `<li role="option" data-i="${i}" aria-selected="false"><a href="${links.tool(t.id)}">
                  <span class="logo logo-sm">${mono(t.name)}<img src="${logoSrc(t.host)}" alt="" width="32" height="32" loading="lazy" referrerpolicy="no-referrer" onload="this.naturalWidth > 16 ? this.parentNode.classList.add('has-img') : this.remove()" onerror="this.remove()"></span>
                  <span class="sr-text"><span class="sr-name">${esc(t.name)}</span><span class="sr-meta">${esc(t.cat)}</span></span>
                  <span class="sr-price">${esc(t.price)}</span></a></li>`,
              )
              .join('')
          : `<li class="sr-empty">No tools match "${esc(input.value.trim())}".</li>`) +
        `<li class="sr-all"><a href="${links.directory(input.value.trim())}">See all results in the directory</a></li>`;
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      active = -1;
    };

    input.addEventListener('input', render);
    input.addEventListener('focus', () => input.value && render());
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (!results.length) return;
        active = (active + (e.key === 'ArrowDown' ? 1 : -1) + results.length) % results.length;
        paint();
      } else if (e.key === 'Escape') {
        close();
      }
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value.trim();
      const pick = results[active >= 0 ? active : 0];
      location.href = pick && q ? links.tool(pick.id) : links.directory(q);
    });
    document.addEventListener('click', (e) => {
      if (!form.contains(e.target as Node)) close();
    });
  });
</script>

---
// Score out of 100 drawn as five stars (each star is 20 points), with the number beside it.
interface Props {
  score: number;
  compact?: boolean;
}
const { score, compact = false } = Astro.props;
---

<span class="stars" role="img" aria-label={`Score ${score} out of 100`}>
  <span class="stars-row" aria-hidden="true"><span style={`width:${score}%`}></span></span>
  <strong aria-hidden="true">{score}</strong>{!compact && <small aria-hidden="true">/100</small>}
</span>

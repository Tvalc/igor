---
import ToolLogo from './ToolLogo.astro';
import Stars from './Stars.astro';
import ProsCons from './ProsCons.astro';
import type { Scored } from '../lib/score';
import { fromPrice, priceLabel } from '../lib/compare';
import { CATEGORY_LABELS, ENGINE_LABELS, STATUS_LABELS, outboundRel, outboundUrl } from '../lib/format';

interface Props {
  scored: Scored;
  rank?: number;
  pick?: string; // "Best overall" etc.
  details?: boolean; // pros/cons and specs
}
const { scored, rank, pick, details = false } = Astro.props;
const t = scored.tool;
const d = t.data;
const dead = d.status === 'discontinued';
const p = fromPrice(t);
const label = priceLabel(t);
const badges: [string, string][] = [];
if (pick) badges.push([pick, 'badge-pick']);
if (d.pricing.free_tier === 'yes') badges.push(['Free plan', 'badge-yes']);
if (d.license.commercial_use === 'yes') badges.push(['Commercial use OK', 'badge-yes']);
if (d.skill_level === 'beginner') badges.push(['Beginner friendly', 'badge-accent']);
if (d.license.open_source) badges.push(['Open source', 'badge-accent']);
if (d.status !== 'active') badges.push([STATUS_LABELS[d.status], 'badge-muted']);
---

<li
  class="tcard"
  data-item
  data-id={t.id}
  data-name={d.name}
  data-text={`${d.name} ${d.tagline} ${d.tags.join(' ')}`.toLowerCase()}
  data-cats={d.categories.join(' ')}
  data-engines={d.engines.join(' ')}
  data-exports={d.exports.join(' ')}
  data-free={d.pricing.free_tier}
  data-price={p ?? ''}
  data-commercial={d.license.commercial_use}
  data-skill={d.skill_level}
  data-score={dead ? -1 : scored.score}
  data-rank={rank}
>
  {rank && <span class:list={['tcard-rank', { r1: rank === 1 }]}>{rank}</span>}
  <ToolLogo name={d.name} url={d.url} size="md" />
  <div class="tcard-main">
    <div class="tcard-title">
      <h3><a href={`/tools/${t.id}`}>{d.name}</a></h3>
      {!dead && <Stars score={scored.score} compact />}
      {d.makko_owned && <span class="pill owned" title="Built by the team that runs this site">Our team</span>}
    </div>
    <p class="tcard-desc">{details ? d.best_for : d.tagline}</p>
    {badges.length > 0 && <div class="badges">{badges.map(([b, c]) => <span class={`badge ${c}`}>{b}</span>)}</div>}
    {
      details && (
        <p class="tcard-specs">
          <span><b>Type:</b> {d.categories.map((c) => CATEGORY_LABELS[c]).join(', ')}</span>
          {d.engines.length > 0 && <span><b>Engines:</b> {d.engines.map((e) => ENGINE_LABELS[e]).join(', ')}</span>}
          {d.platforms.length > 0 && <span><b>Runs on:</b> {d.platforms.join(', ')}</span>}
        </p>
      )
    }
  </div>
  <div class="tcard-side">
    <div class="tcard-price">
      {label === 'Unverified' ? <span class="unverified">See site for pricing</span> : label}
      {p !== null && p > 0 && <small>starting price</small>}
    </div>
    {
      !dead && (
        <a class="btn btn-sm" href={outboundUrl(t)} rel={outboundRel(t)} target="_blank">
          Visit site
        </a>
      )
    }
    {
      !dead && (
        <label class="tcard-cmp">
          <input type="checkbox" data-compare={t.id} aria-label={`Compare ${d.name}`} /> Compare
        </label>
      )
    }
  </div>
  {details && <ProsCons tool={t} max={3} />}
</li>

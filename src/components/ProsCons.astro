---
import type { Tool } from '../lib/score';
import { prosCons } from '../lib/proscons';

interface Props {
  tool: Tool;
  max?: number;
}
const { tool, max = 4 } = Astro.props;
const { pros, cons } = prosCons(tool);
---

<div class="proscons">
  {
    pros.length > 0 && (
      <div class="pros">
        <h4>Pros</h4>
        <ul>{pros.slice(0, max).map((p) => <li>{p}</li>)}</ul>
      </div>
    )
  }
  {
    cons.length > 0 && (
      <div class="cons">
        <h4>Cons</h4>
        <ul>{cons.slice(0, max).map((c) => <li>{c}</li>)}</ul>
      </div>
    )
  }
</div>

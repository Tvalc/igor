---
// Vendor logo from the tool's own site icon, over a monogram that shows until (or instead of) the image.
import Monogram from './Monogram.astro';
import { logoSrc } from '../lib/links';

interface Props {
  name: string;
  url: string;
  size?: 'sm' | 'md' | 'lg';
}
const { name, url, size = 'md' } = Astro.props;
const host = new URL(url).hostname.replace(/^www\./, '');
// Repos on GitHub would all show GitHub's icon, which says nothing about the tool.
const src = host === 'github.com' ? null : logoSrc(host);
---

<span class={`logo logo-${size}`}>
  <Monogram name={name} size={size} />
  {
    src && (
      <img
        src={src}
        alt=""
        width="64"
        height="64"
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        onload="this.naturalWidth > 16 ? this.parentNode.classList.add('has-img') : this.remove()"
        onerror="this.remove()"
      />
    )
  }
</span>

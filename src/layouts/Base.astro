---
import '../styles/global.css';
import { NAV, SECTION_INDEXES, SITE } from '../site';
import { breadcrumbs as breadcrumbsLd } from '../lib/jsonld';
import { publishedLists } from '../lib/lists';
import BrandMark from '../components/BrandMark.astro';

interface Props {
  title: string;
  description: string;
  crumbs?: { name: string; href: string }[];
  jsonLd?: object[];
  markdownPath?: string; // the .md mirror of this page, if any
  noindex?: boolean;
}

const { title, description, crumbs = [], jsonLd = [], markdownPath, noindex = false } = Astro.props;
const base = Astro.site!.toString().replace(/\/$/, '');
// Section indexes keep their trailing slash (/tools/); leaf pages are extensionless (/tools/x).
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/(\/index)?\/?$/, '');
const canonical = new URL(SECTION_INDEXES.includes(`${path}/`) ? `${path}/` : path || '/', Astro.site).toString();
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const ogImage = new URL('/og.png', Astro.site).toString();
const footerLists = (await publishedLists()).slice(0, 8);
const ld = [...jsonLd];
if (crumbs.length) {
  ld.push(breadcrumbsLd([{ name: 'Home', url: base }, ...crumbs.map((c) => ({ name: c.name, url: base + c.href }))]));
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffd000" />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${SITE.name} home`}><BrandMark /><span>{SITE.brand.lead} <b>{SITE.brand.accent}</b></span></a>
        <nav aria-label="Main">
          {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <slot name="hero" />
    <main class="wrap">
      {
        crumbs.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            {crumbs.map((c, i) => (
              <>
                {' › '}
                {i === crumbs.length - 1 ? <span>{c.name}</span> : <a href={c.href}>{c.name}</a>}
              </>
            ))}
          </nav>
        )
      }
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand" href="/"><BrandMark /><span>{SITE.brand.lead} <b>{SITE.brand.accent}</b></span></a>
            <p>
              Every tool for making games with AI, ranked on a public rubric from verified facts. Run by {SITE.owner};
              Makko is scored like every other tool, and affiliate links or sponsorships never change a score.
            </p>
          </div>
          <div>
            <h2>Rankings</h2>
            <ul>{footerLists.map(({ def }) => <li><a href={`/best/${def.slug}`}>{def.title.replace(/^Best /, '')}</a></li>)}</ul>
          </div>
          <div>
            <h2>Guides</h2>
            <ul>
              <li><a href="/guides/how-to-make-a-game-with-ai">Make a game with AI</a></li>
              <li><a href="/guides/make-2d-games-with-ai">Make 2D games with AI</a></li>
              <li><a href="/guides/make-game-art-with-ai">Make game art with AI</a></li>
              <li><a href="/compare/">Head-to-head comparisons</a></li>
              <li><a href="/tools/">All tools</a></li>
            </ul>
          </div>
          <div>
            <h2>About</h2>
            <ul>
              <li><a href="/methodology">How we rank</a></li>
              <li><a href="/disclosure">Ownership &amp; disclosure</a></li>
              <li><a href="/about">About</a></li>
              <li><a href="/llms.txt">llms.txt (for AI agents)</a></li>
              <li><a href="/sitemap.xml">Sitemap</a></li>
            </ul>
          </div>
        </div>
        <p class="footer-note">
          © {SITE.year} {SITE.name}. Tool names and trademarks belong to their owners. Facts are verified against
          primary sources; corrections welcome.
        </p>
      </div>
    </footer>
  </body>
</html>
